{
  "lastChangelogVersion": "1.3.0",
  "theme": "random",
  "packages": [
    "npm:pi-antigravity",
    "git:github.com/J3fp/piQuota",
    "npm:@amaster.ai/pi-image-gen",
    "npm:pi-free",
    "npm:pi-google-workspace",
    "npm:@ygncode/pi-insights",
    "npm:pi-image-preview",
    "npm:@parke.dev/pi-subagent",
    "npm:pi-background-tasks"
  ],
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-3.8-flash",
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "cacheWarming": "idle",
  "modelCacheWarming": {
    "antigravity/gemini-3.8-flash": "force",
    "antigravity/*flash*": "streaming",
    "*gpt-6-luna*": "streaming",
    "default": "idle"
  },
  "pi-image-gen": {
    "defaultModel": "gpt-image-2.5"
  },
  "enabledModels": [
    "antigravity/gemini-3.8-flash",
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra",
    "antigravity/gemini-3.5-flash-lite",
    "anthropic/claude-haiku-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-1",
    "antigravity/claude-sonnet-5-5",
    "antigravity/claude-opus-5-5",
    "antigravity/gemini-4-argon"
  ],
  "hideThinkingBlock": false,
  "steeringMode": "all",
  "httpIdleTimeoutMs": 0,
  "markdown": {
    "mermaid": "streaming"
  },
  "quietStartup": true,
  "collapseChangelog": true,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "none",
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "defaultTools": [
    "+codemode"
  ],
  "quota": {
    "surface": "line"
  }
}
