#!/bin/sh
case "$0" in
  */*) pi_launcher="$0" ;;
  *) pi_launcher=$(command -v "$0") || exit 127 ;;
esac
while [ -L "$pi_launcher" ]; do
  pi_link=$(readlink "$pi_launcher") || exit 1
  case "$pi_link" in
    /*) pi_launcher="$pi_link" ;;
    *) pi_launcher=${pi_launcher%/*}/$pi_link ;;
  esac
done
pi_bin_dir=${pi_launcher%/*}
pi_agent_dir=${pi_bin_dir%/*}
pi_current_file=$pi_agent_dir/install/current-version
if ! IFS= read -r pi_current_version < "$pi_current_file"; then
  printf 'Could not read managed Pi version from %s.\n' "$pi_current_file" >&2
  exit 1
fi
case "$pi_current_version" in
  ""|.|..|*[!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._+-]*)
    printf 'Managed Pi version file is invalid: %s\n' "$pi_current_file" >&2
    exit 1
    ;;
esac
pi_release_dir=$pi_agent_dir/install/releases/$pi_current_version
pi_release_bin=$pi_release_dir/node_modules/.bin/pi
if [ ! -x "$pi_release_bin" ]; then
  printf 'Managed Pi executable is missing: %s\n' "$pi_release_bin" >&2
  exit 1
fi
# Node.js installed by the Pi installer is not added to shell profiles, so put
# it on PATH for pi's shebang and for child processes: npm in pi update and
# commands run through pi's bash tool.
pi_node_bin=${XDG_DATA_HOME:-$HOME/.local/share}/pi-node/current/bin
if [ -x "$pi_node_bin/node" ]; then
  PATH=$pi_node_bin:$PATH
  export PATH
fi
PI_MANAGED_INSTALL_ROOT=$pi_agent_dir/install
export PI_MANAGED_INSTALL_ROOT

# Keep Node V8 heap bounded to 2GB to prevent lazy memory growth and preemptive LMKD SIGKILL
case "${NODE_OPTIONS:-}" in
  *--max-old-space-size*) ;;
  *) export NODE_OPTIONS="--max-old-space-size=2048 ${NODE_OPTIONS:-}" ;;
esac

# Ensure quota line default preference before launching Pi (box should never be on by default)
if [ -x "$pi_agent_dir/bin/ensure-quota-line.sh" ]; then
  "$pi_agent_dir/bin/ensure-quota-line.sh" >/dev/null 2>&1 || true
fi

# Disable pi-background-tasks ambient Anthropic attribution for standard API keys
if [ -z "${PI_BG_FEATURES:-}" ]; then
  export PI_BG_FEATURES="process,delegate,fusion,attested"
fi

# Ensure Gemini 4 Argon stream stall timeout defaults (300s mid-stream stall, 180s header deadline)
if [ -z "${ANTIGRAVITY_STREAM_STALL_TIMEOUT_MS:-}" ]; then
  export ANTIGRAVITY_STREAM_STALL_TIMEOUT_MS=300000
fi
if [ -z "${ANTIGRAVITY_STREAM_HEADER_TIMEOUT_MS:-}" ]; then
  export ANTIGRAVITY_STREAM_HEADER_TIMEOUT_MS=180000
fi

"$pi_release_bin" "$@"
status=$?

# If terminated by SIGKILL (137 = 128 + 9), SIGSEGV (139 = 128 + 11), or SIGTERM (143 = 128 + 15)
if [ "$status" -eq 137 ] || [ "$status" -eq 139 ] || [ "$status" -eq 143 ]; then
  mkdir -p "$pi_agent_dir/logs"
  log_file="$pi_agent_dir/logs/crash-diagnostics.log"
  {
    printf '\n=== PI ABNORMAL TERMINATION DETECTED [%s] ===\n' "$(date -u +'%Y-%m-%d %H:%M:%SZ')"
    printf 'Exit Status: %d (Signal %d)\n' "$status" "$((status - 128))"
    printf 'Args: %s\n' "$*"
    printf 'Memory Status:\n'
    grep -E '^(MemTotal|MemFree|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo 2>/dev/null
    printf 'Top Processes by RSS:\n'
    ps -eo pid,ppid,rss,vsz,comm --sort=-rss 2>/dev/null | head -n 8
    printf '===============================================\n'
  } >> "$log_file" 2>/dev/null

  if [ "$status" -eq 137 ]; then
    printf '\n\033[1;33m[Pi Crash Guard]\033[0m Pi was terminated by SIGKILL (Signal 9 - Android LMKD / Out of Memory).\n' >&2
    printf '  • Diagnostics recorded to: %s\n' "$log_file" >&2
    printf '  • To resume your session, run: \033[1;32mpi -c\033[0m\n\n' >&2
  elif [ "$status" -eq 139 ]; then
    printf '\n\033[1;31m[Pi Crash Guard]\033[0m Pi encountered a native crash (SIGSEGV / Signal 11).\n' >&2
    printf '  • Diagnostics recorded to: %s\n' "$log_file" >&2
    printf '  • To resume your session, run: \033[1;32mpi -c\033[0m\n\n' >&2
  fi
fi

exit "$status"
